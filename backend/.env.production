# ============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================================
# This file contains production environment settings.
# CRITICAL SECURITY WARNINGS:
# - All passwords and API keys MUST be changed before deployment!
# - Use secrets management systems (AWS Secrets Manager, HashiCorp Vault, etc.)
# - Enable all security features and monitoring
# - Regularly rotate credentials
# - Never commit actual production credentials to version control!
# ============================================================================

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
APP_NAME="GenAI Knowledge Retrieval System"
APP_VERSION="1.0.0"
ENVIRONMENT="production"
DEBUG=false
LOG_LEVEL="WARNING"

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
HOST="0.0.0.0"
PORT=8000
WORKERS=8
REQUEST_TIMEOUT=300

# ============================================================================
# DATABASE CONFIGURATION - PostgreSQL
# ============================================================================
# SECURITY WARNING: Use strong passwords (min 32 chars) and SSL connections!
DATABASE_URL="postgresql+asyncpg://genai_prod_user:CHANGE_ME_STRONG_PRODUCTION_PASSWORD@postgres-prod:5432/genai_kb_prod?ssl=require"
DATABASE_POOL_SIZE=30
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
# SECURITY WARNING: Enable Redis authentication in production!
REDIS_URL="redis://:CHANGE_ME_REDIS_PASSWORD@redis-prod:6379/0?ssl=true"
REDIS_SESSION_DB=1
REDIS_CACHE_DB=2
REDIS_POOL_SIZE=100
REDIS_TIMEOUT=5

# ============================================================================
# ELASTICSEARCH CONFIGURATION
# ============================================================================
ELASTICSEARCH_URL="https://elasticsearch-prod:9200"
ELASTICSEARCH_USERNAME="elastic"
ELASTICSEARCH_PASSWORD="CHANGE_ME_STRONG_ELASTICSEARCH_PASSWORD"
ELASTICSEARCH_INDEX_PREFIX="genai_kb_prod"
ELASTICSEARCH_SSL_VERIFY=true

# ============================================================================
# SECURITY & AUTHENTICATION
# ============================================================================
# SECURITY WARNING: Generate cryptographically secure key!
# Generate with: openssl rand -hex 32
SECRET_KEY="CHANGE_ME_MUST_BE_CRYPTOGRAPHICALLY_SECURE_64_CHAR_MINIMUM"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=14

# ============================================================================
# ADMIN CREDENTIALS (Initial Setup)
# ============================================================================
# SECURITY WARNING: Change IMMEDIATELY after first deployment!
# Disable this account after setting up proper OAuth2/SSO!
ADMIN_EMAIL="admin@production.example.com"
ADMIN_PASSWORD="CHANGE_ME_IMMEDIATELY_AFTER_DEPLOYMENT"

# ============================================================================
# OAUTH2 CONFIGURATION
# ============================================================================
OAUTH2_PROVIDER="google"
OAUTH2_CLIENT_ID="CHANGE_ME_PRODUCTION_OAUTH2_CLIENT_ID"
OAUTH2_CLIENT_SECRET="CHANGE_ME_PRODUCTION_OAUTH2_CLIENT_SECRET"
OAUTH2_AUTHORIZATION_ENDPOINT="https://accounts.google.com/o/oauth2/v2/auth"
OAUTH2_TOKEN_ENDPOINT="https://oauth2.googleapis.com/token"
OAUTH2_USERINFO_ENDPOINT="https://www.googleapis.com/oauth2/v2/userinfo"
OAUTH2_REDIRECT_URI="https://production.example.com/api/v1/auth/oauth2/callback"
OAUTH2_SCOPES="openid profile email"

# ============================================================================
# LLM CONFIGURATION - OpenAI
# ============================================================================
# SECURITY WARNING: Protect API keys! Monitor usage and costs!
OPENAI_API_KEY="sk-CHANGE_ME_PRODUCTION_OPENAI_API_KEY"
OPENAI_MODEL="gpt-4-turbo-preview"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000
OPENAI_API_BASE=""
OPENAI_ORGANIZATION="CHANGE_ME_YOUR_OPENAI_ORGANIZATION_ID"

# ============================================================================
# LLM PROVIDER CONFIGURATION
# ============================================================================
LLM_PROVIDER="openai"

# ============================================================================
# LLM CONFIGURATION - Ollama (Alternative)
# ============================================================================
OLLAMA_ENABLED=false
OLLAMA_BASE_URL="http://ollama-prod:11434"
OLLAMA_MODEL="llama2"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"
OLLAMA_TIMEOUT=120

# ============================================================================
# VECTOR DATABASE CONFIGURATION
# ============================================================================
VECTOR_DB_TYPE="pinecone"
CHROMA_PERSIST_DIRECTORY="/data/chroma"
CHROMA_COLLECTION_NAME="knowledge_base_prod"
PINECONE_API_KEY="CHANGE_ME_PRODUCTION_PINECONE_API_KEY"
PINECONE_ENVIRONMENT="us-east1-gcp"
PINECONE_INDEX_NAME="genai-kb-production"
EMBEDDING_DIMENSIONS=1536

# ============================================================================
# EXTERNAL API INTEGRATIONS - Confluence
# ============================================================================
CONFLUENCE_URL="https://your-company.atlassian.net/wiki"
CONFLUENCE_USERNAME="confluence-prod-api@company.com"
CONFLUENCE_API_TOKEN="CHANGE_ME_PRODUCTION_CONFLUENCE_TOKEN"
CONFLUENCE_SPACE_KEYS="KB,DOCS,ONBOARD,SUPPORT"
CONFLUENCE_PAGE_LIMIT=100
CONFLUENCE_INGEST_ATTACHMENTS=true

# ============================================================================
# EXTERNAL API INTEGRATIONS - Jira
# ============================================================================
JIRA_URL="https://your-company.atlassian.net"
JIRA_USERNAME="jira-prod-api@company.com"
JIRA_API_TOKEN="CHANGE_ME_PRODUCTION_JIRA_TOKEN"
JIRA_PROJECT_KEYS="PROJ,SUPPORT,OPS"
JIRA_ISSUE_LIMIT=100
JIRA_INGEST_CLOSED_ISSUES=true


# ============================================================================
# DATA INGESTION SETTINGS
# ============================================================================
INGESTION_SCHEDULE_CRON="0 */4 * * *"
INGESTION_BATCH_SIZE=200
INGESTION_MAX_RETRIES=5
INGESTION_RETRY_DELAY=120
INGESTION_AUTO_START=true

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=100
RATE_LIMIT_ADMIN_PER_MINUTE=120
RATE_LIMIT_ANONYMOUS_PER_MINUTE=10
RATE_LIMIT_ENABLED=true

# ============================================================================
# CORS SETTINGS
# ============================================================================
# SECURITY WARNING: Set specific allowed origins, never use "*"!
CORS_ORIGINS="https://app.production.example.com,https://production.example.com"
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS="GET,POST,PUT,DELETE,PATCH,OPTIONS"
CORS_ALLOW_HEADERS="Authorization,Content-Type,X-Request-ID"

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
LOG_FORMAT="json"
LOG_FILE_PATH="/var/log/genai-kb/app.log"
LOG_MAX_SIZE_MB=500
LOG_BACKUP_COUNT=30
LOG_REQUESTS=true
LOG_SQL_QUERIES=false

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
PROMETHEUS_METRICS_PATH="/metrics"
HEALTHCHECK_ENABLED=true
HEALTHCHECK_PATH="/health"
SENTRY_DSN="https://CHANGE_ME_YOUR_PRODUCTION_SENTRY_DSN@sentry.io/project"
SENTRY_ENVIRONMENT="production"
SENTRY_SAMPLE_RATE=0.2

# ============================================================================
# CELERY (Background Tasks)
# ============================================================================
CELERY_BROKER_URL="redis://:CHANGE_ME_REDIS_PASSWORD@redis-prod:6379/3?ssl=true"
CELERY_RESULT_BACKEND="redis://:CHANGE_ME_REDIS_PASSWORD@redis-prod:6379/4?ssl=true"
CELERY_TASK_TIME_LIMIT=7200
CELERY_TASK_SOFT_TIME_LIMIT=6600
CELERY_MAX_TASKS_PER_CHILD=1000
CELERY_WORKER_CONCURRENCY=8

# ============================================================================
# PERFORMANCE TUNING
# ============================================================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_SEARCH_RESULTS=10
SIMILARITY_THRESHOLD=0.80
MAX_CONTEXT_LENGTH=4000
CACHE_TTL=7200

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_CLARIFICATION_QUESTIONS=true
ENABLE_SOURCE_CITATIONS=true
ENABLE_METRICS_TRACKING=true
ENABLE_CONVERSATION_HISTORY=true
ENABLE_FEEDBACK_COLLECTION=true
ENABLE_MULTILINGUAL=true
