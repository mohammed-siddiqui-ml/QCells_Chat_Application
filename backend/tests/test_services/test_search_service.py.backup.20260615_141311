# TC-013: Cosine Distance to Similarity Conversion
# ============================================================================

@pytest.mark.asyncio
@pytest.mark.requires_postgres  # Fix: Add PostgreSQL requirement marker
async def test_cosine_distance_to_similarity(
    search_service,
    db_session,
    sample_documents
):
    """
    TC-013: Verify cosine distance to similarity score conversion.

    Expected:
    - Similarity score = 1 - (distance / 2)
    - Scores range from 0.0 to 1.0
    - Distance 0.0 (identical) → similarity 1.0
    - Distance 2.0 (opposite) → similarity 0.0
    """
    # Create chunks with controlled embeddings
    # Identical embedding (distance = 0)
    identical_embedding = [1.0] + [0.0] * 383
    chunk1 = DocumentChunk(
        id=uuid4(),
        document_id=sample_documents[0].id,
        content="Identical",
        chunk_index=0,
        embedding=identical_embedding
    )

    # Perpendicular embedding (distance ≈ 1.0 for normalized vectors)
    perpendicular_embedding = [0.0, 1.0] + [0.0] * 382
    chunk2 = DocumentChunk(
        id=uuid4(),
        document_id=sample_documents[1].id,
        content="Perpendicular",
        chunk_index=0,
        embedding=perpendicular_embedding
    )

    db_session.add(chunk1)
    db_session.add(chunk2)
    await db_session.commit()

    # Search with identical embedding
    results = await search_service.semantic_search(
        db=db_session,
        query_embedding=identical_embedding,
        top_k=10
    )

    # Find the identical chunk
    identical_result = next((r for r in results if r["content"] == "Identical"), None)
    assert identical_result is not None

    # Verify similarity score is close to 1.0 (distance ≈ 0)
    assert identical_result["score"] > 0.99, f"Expected score ~1.0, got {identical_result['score']}"

    # Verify all scores are in valid range
    for result in results:
        assert 0.0 <= result["score"] <= 1.0, f"Score {result['score']} out of range"


