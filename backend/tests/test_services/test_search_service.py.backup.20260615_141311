@pytest.mark.asyncio
async def test_hybrid_search_parallel_execution(search_service, db_session, mock_elasticsearch):
    """
    TC-008: Hybrid search executes semantic and keyword searches in parallel.

    Expected:
    - Total execution time approximately max(0.2, 0.2) = 0.2s
    - Not sum(0.2 + 0.2) = 0.4s (proves parallel execution)
    """
    import time

    # Create a slow semantic search mock
    async def slow_semantic(*args, **kwargs):
        await asyncio.sleep(0.2)
        return []

    # Create a slow keyword search mock
    async def slow_keyword(*args, **kwargs):
        await asyncio.sleep(0.2)
        return []

    # Patch both methods
    with patch.object(search_service, 'semantic_search', side_effect=slow_semantic), \
         patch.object(search_service, 'keyword_search', side_effect=slow_keyword), \
         patch("app.services.search_service.embedding_service") as mock_embedding:

        mock_embedding.generate_embeddings = AsyncMock(return_value=[[0.5] * 384])

        start_time = time.time()
        await search_service.hybrid_search(db=db_session, query="test", top_k=10)
        elapsed_time = time.time() - start_time

    # Verify parallel execution (should be ~0.2s, not ~0.4s)
    # Allow some overhead, so check if < 0.35s
    assert elapsed_time < 0.35, f"Expected parallel execution (~0.2s), got {elapsed_time}s"


