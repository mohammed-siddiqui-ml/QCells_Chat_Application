# ============================================================================
# TC-005: RRF Algorithm - No Duplicates
# ============================================================================

@pytest.mark.asyncio
async def test_rrf_no_duplicates(search_service):
    """
    TC-005: RRF algorithm correctly combines non-overlapping result sets.

    Expected:
    - 6 unique results returned
    - RRF scores calculated with k=60
    - Results sorted by descending RRF score
    """
    # Create semantic results (3 docs, ranks 1-3)
    semantic_results = [
        {"chunk_id": "doc1", "content": "Content 1", "title": "Title 1", "url": "url1",
         "source_type": "confluence", "score": 0.95, "rank": 1},
        {"chunk_id": "doc2", "content": "Content 2", "title": "Title 2", "url": "url2",
         "source_type": "confluence", "score": 0.85, "rank": 2},
        {"chunk_id": "doc3", "content": "Content 3", "title": "Title 3", "url": "url3",
         "source_type": "confluence", "score": 0.75, "rank": 3},
    ]

    # Create keyword results (3 different docs, ranks 1-3)
    keyword_results = [
        {"chunk_id": "doc4", "content": "Content 4", "title": "Title 4", "url": "url4",
         "source_type": "jira", "score": 10.0, "rank": 1},
        {"chunk_id": "doc5", "content": "Content 5", "title": "Title 5", "url": "url5",
         "source_type": "jira", "score": 8.0, "rank": 2},
        {"chunk_id": "doc6", "content": "Content 6", "title": "Title 6", "url": "url6",
         "source_type": "jira", "score": 6.0, "rank": 3},
    ]

    # Apply RRF fusion
    fused_results = search_service._reciprocal_rank_fusion(
        semantic_results=semantic_results,
        keyword_results=keyword_results
    )

    # Verify 6 unique results
    assert len(fused_results) == 6

    # Verify RRF scores (k=60)
    # Rank 1: 1/(60+1) = 1/61 ≈ 0.0164
    # Top results should be doc1 and doc4 (both rank 1)
    doc1 = next((r for r in fused_results if r["chunk_id"] == "doc1"), None)
    doc4 = next((r for r in fused_results if r["chunk_id"] == "doc4"), None)

    assert doc1 is not None
    assert doc4 is not None

    expected_score = 1.0 / (60 + 1)
    assert abs(doc1["rrf_score"] - expected_score) < 0.001
    assert abs(doc4["rrf_score"] - expected_score) < 0.001

    # Verify results sorted by descending RRF score
    rrf_scores = [r["rrf_score"] for r in fused_results]
    assert rrf_scores == sorted(rrf_scores, reverse=True)


# ============================================================================
# TC-006: RRF Algorithm - With Duplicates
# ============================================================================

@pytest.mark.asyncio
async def test_rrf_with_duplicates(search_service):
    """
    TC-006: RRF algorithm handles duplicate results correctly.

    Expected:
    - 5 unique results (doc1 appears in both lists, counted once)
    - doc1 RRF score = 1/61 + 1/61 = 2/61 (highest score)
    - doc1 has both semantic_rank=1 and keyword_rank=1
    """
    # Create results with doc1 in both lists
    semantic_results = [
        {"chunk_id": "doc1", "content": "Content 1", "title": "Title 1", "url": "url1",
         "source_type": "confluence", "score": 0.95, "rank": 1},
        {"chunk_id": "doc2", "content": "Content 2", "title": "Title 2", "url": "url2",
         "source_type": "confluence", "score": 0.85, "rank": 2},
        {"chunk_id": "doc3", "content": "Content 3", "title": "Title 3", "url": "url3",
         "source_type": "confluence", "score": 0.75, "rank": 3},
    ]

    keyword_results = [
        {"chunk_id": "doc1", "content": "Content 1", "title": "Title 1", "url": "url1",
         "source_type": "confluence", "score": 10.0, "rank": 1},  # Duplicate!
        {"chunk_id": "doc4", "content": "Content 4", "title": "Title 4", "url": "url4",
         "source_type": "jira", "score": 8.0, "rank": 2},
        {"chunk_id": "doc5", "content": "Content 5", "title": "Title 5", "url": "url5",
         "source_type": "jira", "score": 6.0, "rank": 3},
    ]

    # Apply RRF fusion
    fused_results = search_service._reciprocal_rank_fusion(
        semantic_results=semantic_results,
        keyword_results=keyword_results
    )

    # Verify 5 unique results (not 6)
    assert len(fused_results) == 5

    # Find doc1 in fused results
    doc1 = next((r for r in fused_results if r["chunk_id"] == "doc1"), None)
    assert doc1 is not None

    # Verify doc1 has the highest RRF score (appears in both lists at rank 1)
    expected_score = (1.0 / 61) + (1.0 / 61)  # 2/61
    assert abs(doc1["rrf_score"] - expected_score) < 0.001

    # Verify doc1 is first in results (highest RRF score)
    assert fused_results[0]["chunk_id"] == "doc1"

    # Verify doc1 has both semantic_rank and keyword_rank
    assert doc1["semantic_rank"] == 1
    assert doc1["keyword_rank"] == 1


