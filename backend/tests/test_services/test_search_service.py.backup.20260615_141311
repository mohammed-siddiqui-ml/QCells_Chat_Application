@pytest.mark.asyncio
@pytest.mark.requires_postgres  # Fix: Add PostgreSQL requirement marker
async def test_semantic_search_valid_query(
    search_service,
    db_session,
    sample_chunks_with_embeddings,
    sample_embedding
):
    """
    TC-001: Semantic search returns top-k results ordered by cosine similarity.

    Expected:
    - Returns 3 results (top_k=3)
    - Results ordered by descending similarity score
    - Each result contains: chunk_id, content, title, url, source_type, score
    - Score is between 0.0 and 1.0
    """
    # Execute semantic search
    results = await search_service.semantic_search(
        db=db_session,
        query_embedding=sample_embedding,
        top_k=3
    )

    # Verify result count
    assert len(results) == 3, f"Expected 3 results, got {len(results)}"

    # Verify results are ordered by descending score
