# ============================================================================
# GenAI Knowledge Retrieval System - Environment Configuration
# ============================================================================
# This file contains all environment variables required to run the application.
# Copy this file to .env and configure with your actual values.
# SECURITY WARNING: Never commit .env files with real credentials to version control!
# ============================================================================

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Application name displayed in logs and UI
APP_NAME="GenAI Knowledge Retrieval System"

# Semantic version of the application
APP_VERSION="1.0.0"

# Environment name: development, staging, production
ENVIRONMENT="development"

# Enable debug mode (WARNING: Set to false in production!)
DEBUG=true

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL="INFO"

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Server bind address (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
HOST="0.0.0.0"

# Server port number
PORT=8000

# Number of worker processes (recommended: 2-4 x CPU cores)
WORKERS=4

# Maximum request timeout in seconds
REQUEST_TIMEOUT=300

# ============================================================================
# DATABASE CONFIGURATION - PostgreSQL
# ============================================================================

# PostgreSQL connection URL (format: postgresql+asyncpg://user:password@host:port/database)
# SECURITY WARNING: Change default credentials in production!
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/genai_kb"

# Database connection pool size
DATABASE_POOL_SIZE=20

# Maximum overflow connections beyond pool size
DATABASE_MAX_OVERFLOW=10

# Connection pool timeout in seconds
DATABASE_POOL_TIMEOUT=30

# Enable SQL query echo for debugging (WARNING: Set to false in production!)
DATABASE_ECHO=false

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================

# Primary Redis connection URL
REDIS_URL="redis://localhost:6379/0"

# Redis database index for session storage
REDIS_SESSION_DB=1

# Redis database index for application cache
REDIS_CACHE_DB=2

# Redis connection pool size
REDIS_POOL_SIZE=50

# Redis connection timeout in seconds
REDIS_TIMEOUT=5

# ============================================================================
# ELASTICSEARCH CONFIGURATION (Optional)
# ============================================================================

# Elasticsearch host URL (leave empty to disable Elasticsearch)
ELASTICSEARCH_URL=""

# Elasticsearch username for authentication
ELASTICSEARCH_USERNAME=""

# SECURITY WARNING: Store Elasticsearch password securely!
ELASTICSEARCH_PASSWORD=""

# Elasticsearch index name prefix
ELASTICSEARCH_INDEX_PREFIX="genai_kb"

# Enable Elasticsearch SSL verification
ELASTICSEARCH_SSL_VERIFY=true

# ============================================================================
# MINIO OBJECT STORAGE CONFIGURATION
# ============================================================================

# MinIO server endpoint (without http/https prefix)
MINIO_ENDPOINT="localhost:9000"

# MinIO access key (username)
# SECURITY WARNING: Change default credentials in production!
MINIO_ACCESS_KEY="minioadmin"

# MinIO secret key (password)
# SECURITY WARNING: Change default credentials in production!
MINIO_SECRET_KEY="minioadmin"

# Use HTTPS for MinIO connection (true/false)
MINIO_SECURE=false

# Default bucket name for knowledge base documents
MINIO_BUCKET_NAME="knowledge-base"

# MinIO region (default: us-east-1)
MINIO_REGION="us-east-1"

# ============================================================================
# SECURITY & AUTHENTICATION
# ============================================================================

# Secret key for JWT token signing
# SECURITY WARNING: Generate a strong random key and keep it secret!
# Generate with: openssl rand -hex 32
SECRET_KEY="your-secret-key-change-this-in-production-use-openssl-rand-hex-32"

# JWT signing algorithm
ALGORITHM="HS256"

# Access token expiration time in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token expiration time in days
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password hashing rounds (higher = more secure but slower)
BCRYPT_ROUNDS=12

# ============================================================================
# ADMIN CREDENTIALS (Initial Setup)
# ============================================================================

# Default admin user email
# SECURITY WARNING: Change immediately after first login!
ADMIN_EMAIL="admin@example.com"

# Default admin user password
# SECURITY WARNING: Change immediately after first login!
ADMIN_PASSWORD="changeme"

# ============================================================================
# OAUTH2 CONFIGURATION
# ============================================================================

# OAuth2 provider (e.g., google, github, azure)
OAUTH2_PROVIDER=""

# OAuth2 client ID from provider
OAUTH2_CLIENT_ID=""

# SECURITY WARNING: Keep OAuth2 client secret secure!
OAUTH2_CLIENT_SECRET=""

# OAuth2 authorization endpoint
OAUTH2_AUTHORIZATION_ENDPOINT=""

# OAuth2 token endpoint
OAUTH2_TOKEN_ENDPOINT=""

# OAuth2 user info endpoint
OAUTH2_USERINFO_ENDPOINT=""

# OAuth2 redirect URI (must match provider configuration)
OAUTH2_REDIRECT_URI="http://localhost:8000/api/v1/auth/oauth2/callback"

# OAuth2 scopes (space-separated)
OAUTH2_SCOPES="openid profile email"

# ============================================================================
# LLM CONFIGURATION - OpenAI
# ============================================================================

# OpenAI API key
# SECURITY WARNING: Keep API key secure! Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-your-openai-api-key"

# OpenAI chat completion model
OPENAI_MODEL="gpt-4-turbo-preview"

# OpenAI embedding model for vector generation
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Model temperature (0.0 = deterministic, 1.0 = creative)
OPENAI_TEMPERATURE=0.7

# Maximum tokens in model response
OPENAI_MAX_TOKENS=2000

# OpenAI API base URL (for proxies or Azure OpenAI)
OPENAI_API_BASE=""

# OpenAI organization ID (optional)
OPENAI_ORGANIZATION=""

# ============================================================================
# LLM CONFIGURATION - Ollama (Local LLM Alternative)
# ============================================================================

# Enable Ollama for local LLM inference
OLLAMA_ENABLED=false

# Ollama API base URL
OLLAMA_BASE_URL="http://localhost:11434"

# Ollama model name
OLLAMA_MODEL="llama2"

# Ollama embedding model
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"

# Ollama request timeout in seconds
OLLAMA_TIMEOUT=120

# ============================================================================
# VECTOR DATABASE CONFIGURATION
# ============================================================================

# Vector database type: chromadb, pinecone
VECTOR_DB_TYPE="chromadb"

# ChromaDB persistent storage directory
CHROMA_PERSIST_DIRECTORY="./data/chroma"

# ChromaDB collection name
CHROMA_COLLECTION_NAME="knowledge_base"

# Pinecone API key
# SECURITY WARNING: Keep Pinecone API key secure!
PINECONE_API_KEY=""

# Pinecone environment (e.g., us-west1-gcp, us-east1-gcp)
PINECONE_ENVIRONMENT=""

# Pinecone index name
PINECONE_INDEX_NAME="genai-kb-index"

# Vector embedding dimensions
EMBEDDING_DIMENSIONS=1536

# ============================================================================
# EXTERNAL API INTEGRATIONS - Confluence
# ============================================================================

# Confluence base URL (e.g., https://your-domain.atlassian.net/wiki)
CONFLUENCE_URL=""

# Confluence username/email for authentication
CONFLUENCE_USERNAME=""

# Confluence API token
# SECURITY WARNING: Generate from: Account Settings > Security > API Tokens
CONFLUENCE_API_TOKEN=""

# Comma-separated Confluence space keys to ingest (e.g., KB,DOCS,ONBOARD)
CONFLUENCE_SPACE_KEYS=""

# Maximum pages to fetch per request
CONFLUENCE_PAGE_LIMIT=100

# Enable Confluence attachment ingestion
CONFLUENCE_INGEST_ATTACHMENTS=true

# ============================================================================
# EXTERNAL API INTEGRATIONS - Jira
# ============================================================================

# Jira base URL (e.g., https://your-domain.atlassian.net)
JIRA_URL=""

# Jira username/email for authentication
JIRA_USERNAME=""

# Jira API token
# SECURITY WARNING: Generate from: Account Settings > Security > API Tokens
JIRA_API_TOKEN=""

# Comma-separated Jira project keys to ingest (e.g., PROJ,SUPPORT)
JIRA_PROJECT_KEYS=""

# Maximum issues to fetch per request
JIRA_ISSUE_LIMIT=100

# Ingest closed issues (true/false)
JIRA_INGEST_CLOSED_ISSUES=true

# ============================================================================
# DATA INGESTION SETTINGS
# ============================================================================

# Cron schedule for automatic data ingestion (format: "minute hour day month day_of_week")
# Default: "0 */6 * * *" = Every 6 hours at minute 0
INGESTION_SCHEDULE_CRON="0 */6 * * *"

# Number of documents to process in each batch
INGESTION_BATCH_SIZE=100

# Maximum retry attempts for failed ingestion tasks
INGESTION_MAX_RETRIES=3

# Retry delay in seconds (exponential backoff)
INGESTION_RETRY_DELAY=60

# Enable automatic ingestion on startup
INGESTION_AUTO_START=false

# ============================================================================
# RATE LIMITING
# ============================================================================

# Maximum API requests per minute per user
RATE_LIMIT_PER_MINUTE=60

# Burst capacity for rate limiting
RATE_LIMIT_BURST=100

# Rate limit for admin endpoints (per minute)
RATE_LIMIT_ADMIN_PER_MINUTE=120

# Rate limit for anonymous users (per minute)
RATE_LIMIT_ANONYMOUS_PER_MINUTE=20

# Enable rate limiting (true/false)
RATE_LIMIT_ENABLED=true

# ============================================================================
# CORS SETTINGS
# ============================================================================

# Comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Alternative: ALLOWED_ORIGINS (takes precedence over CORS_ORIGINS if set)
# ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# Allow credentials in CORS requests
CORS_ALLOW_CREDENTIALS=true

# Allowed HTTP methods
CORS_ALLOW_METHODS="GET,POST,PUT,DELETE,PATCH,OPTIONS"

# Allowed headers
CORS_ALLOW_HEADERS="*"

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log format: json, text
LOG_FORMAT="json"

# Log file path (relative or absolute)
LOG_FILE_PATH="./logs/app.log"

# Maximum log file size in MB (0 = unlimited)
LOG_MAX_SIZE_MB=100

# Number of backup log files to keep
LOG_BACKUP_COUNT=10

# Enable request logging
LOG_REQUESTS=true

# Enable SQL query logging
LOG_SQL_QUERIES=false

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================

# Enable Prometheus metrics endpoint
PROMETHEUS_ENABLED=true

# Prometheus metrics port
PROMETHEUS_PORT=9090

# Prometheus metrics path
PROMETHEUS_METRICS_PATH="/metrics"

# Enable health check endpoint
HEALTHCHECK_ENABLED=true

# Health check endpoint path
HEALTHCHECK_PATH="/health"

# Sentry DSN for error tracking (leave empty to disable)
# SECURITY WARNING: Keep Sentry DSN secure!
SENTRY_DSN=""

# Sentry environment tag
SENTRY_ENVIRONMENT="development"

# Sentry sample rate (0.0 to 1.0)
SENTRY_SAMPLE_RATE=1.0

# ============================================================================
# RABBITMQ (Message Broker)
# ============================================================================

# RabbitMQ connection URL for Celery broker
RABBITMQ_URL="amqp://guest:guest@localhost:5672/"

# ============================================================================
# CELERY (Background Tasks)
# ============================================================================

# Celery broker URL (Note: Use RabbitMQ via RABBITMQ_URL in production)
CELERY_BROKER_URL="redis://localhost:6379/3"

# Celery result backend URL
CELERY_RESULT_BACKEND="redis://localhost:6379/4"

# Celery task time limit in seconds
CELERY_TASK_TIME_LIMIT=3600

# Celery task soft time limit in seconds (warning before hard limit)
CELERY_TASK_SOFT_TIME_LIMIT=3000

# Maximum tasks per worker before restart
CELERY_MAX_TASKS_PER_CHILD=1000

# Celery concurrency (number of worker threads)
CELERY_WORKER_CONCURRENCY=4

# ============================================================================
# PERFORMANCE TUNING
# ============================================================================

# Document chunk size for text splitting (in characters)
CHUNK_SIZE=1000

# Chunk overlap for context preservation (in characters)
CHUNK_OVERLAP=200

# Maximum search results to return
MAX_SEARCH_RESULTS=10

# Minimum similarity threshold for search results (0.0 to 1.0)
SIMILARITY_THRESHOLD=0.75

# Maximum context length for LLM prompts (in tokens)
MAX_CONTEXT_LENGTH=4000

# Cache TTL in seconds (0 = no expiration)
CACHE_TTL=3600

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable AI clarification questions for ambiguous queries
ENABLE_CLARIFICATION_QUESTIONS=true

# Enable source citations in responses
ENABLE_SOURCE_CITATIONS=true

# Enable usage metrics tracking
ENABLE_METRICS_TRACKING=true

# Enable conversation history
ENABLE_CONVERSATION_HISTORY=true

# Enable feedback collection
ENABLE_FEEDBACK_COLLECTION=true

# Enable multi-language support
ENABLE_MULTILINGUAL=false

# ============================================================================
# END OF CONFIGURATION
# ============================================================================
