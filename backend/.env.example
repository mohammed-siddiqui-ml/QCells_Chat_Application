# Application Settings
APP_NAME="GenAI Knowledge Retrieval System"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

# Server Configuration
HOST="0.0.0.0"
PORT=8000
WORKERS=4

# Database Configuration
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/genai_kb"
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis Configuration
REDIS_URL="redis://localhost:6379/0"
REDIS_SESSION_DB=1
REDIS_CACHE_DB=2

# Security & Authentication
SECRET_KEY="your-secret-key-change-this-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin Credentials (Initial Setup)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="changeme"

# OpenAI Configuration
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_MODEL="gpt-4-turbo-preview"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000

# Vector Database Configuration
VECTOR_DB_TYPE="chromadb"  # Options: chromadb, pinecone
CHROMA_PERSIST_DIRECTORY="./data/chroma"
PINECONE_API_KEY="your-pinecone-api-key"
PINECONE_ENVIRONMENT="us-west1-gcp"
PINECONE_INDEX_NAME="genai-kb-index"

# Confluence Integration
CONFLUENCE_URL="https://your-domain.atlassian.net/wiki"
CONFLUENCE_USERNAME="your-email@example.com"
CONFLUENCE_API_TOKEN="your-confluence-api-token"
CONFLUENCE_SPACE_KEYS="KB,DOCS,ONBOARD"

# Issue Tracking Integration (Jira)
JIRA_URL="https://your-domain.atlassian.net"
JIRA_USERNAME="your-email@example.com"
JIRA_API_TOKEN="your-jira-api-token"
JIRA_PROJECT_KEYS="PROJ,SUPPORT"

# Data Ingestion Settings
INGESTION_SCHEDULE_CRON="0 */6 * * *"  # Every 6 hours
INGESTION_BATCH_SIZE=100
INGESTION_MAX_RETRIES=3

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=100

# CORS Settings
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"
CORS_ALLOW_CREDENTIALS=true

# Logging
LOG_FORMAT="json"
LOG_FILE_PATH="./logs/app.log"

# Celery (Background Tasks)
CELERY_BROKER_URL="redis://localhost:6379/3"
CELERY_RESULT_BACKEND="redis://localhost:6379/4"

# Performance Tuning
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_SEARCH_RESULTS=10
SIMILARITY_THRESHOLD=0.75

# Feature Flags
ENABLE_CLARIFICATION_QUESTIONS=true
ENABLE_SOURCE_CITATIONS=true
ENABLE_METRICS_TRACKING=true
