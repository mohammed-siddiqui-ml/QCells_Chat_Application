# ============================================================================
# LOCAL DEVELOPMENT ENVIRONMENT CONFIGURATION
# ============================================================================
# This file contains development-optimized settings with sensible defaults.
# Use this for local development and testing.
# ============================================================================

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
APP_NAME="GenAI Knowledge Retrieval System"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="DEBUG"

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
HOST="0.0.0.0"
PORT=8000
WORKERS=2
REQUEST_TIMEOUT=300

# ============================================================================
# DATABASE CONFIGURATION - PostgreSQL
# ============================================================================
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/genai_kb"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=true

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
REDIS_URL="redis://localhost:6379/0"
REDIS_SESSION_DB=1
REDIS_CACHE_DB=2
REDIS_POOL_SIZE=20
REDIS_TIMEOUT=5

# ============================================================================
# ELASTICSEARCH CONFIGURATION (Optional)
# ============================================================================
ELASTICSEARCH_URL=""
ELASTICSEARCH_USERNAME=""
ELASTICSEARCH_PASSWORD=""
ELASTICSEARCH_INDEX_PREFIX="genai_kb_dev"
ELASTICSEARCH_SSL_VERIFY=false

# ============================================================================
# SECURITY & AUTHENTICATION
# ============================================================================
SECRET_KEY="dev-secret-key-not-for-production-use-only"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
BCRYPT_ROUNDS=10

# ============================================================================
# ADMIN CREDENTIALS (Development Only)
# ============================================================================
ADMIN_EMAIL="admin@localhost"
ADMIN_PASSWORD="admin123"

# ============================================================================
# OAUTH2 CONFIGURATION (Optional)
# ============================================================================
OAUTH2_PROVIDER=""
OAUTH2_CLIENT_ID=""
OAUTH2_CLIENT_SECRET=""
OAUTH2_AUTHORIZATION_ENDPOINT=""
OAUTH2_TOKEN_ENDPOINT=""
OAUTH2_USERINFO_ENDPOINT=""
OAUTH2_REDIRECT_URI="http://localhost:8000/api/v1/auth/oauth2/callback"
OAUTH2_SCOPES="openid profile email"

# ============================================================================
# LLM CONFIGURATION - OpenAI
# ============================================================================
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4-turbo-preview"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000
OPENAI_API_BASE=""
OPENAI_ORGANIZATION=""

# ============================================================================
# EMBEDDING SERVICE CONFIGURATION
# ============================================================================
EMBEDDING_MODEL="local"
LOCAL_EMBEDDING_MODEL="all-MiniLM-L6-v2"
EMBEDDING_CACHE_TTL=86400
EMBEDDING_BATCH_SIZE=32

# ============================================================================
# LLM CONFIGURATION - Ollama (Recommended for Local Development)
# ============================================================================
OLLAMA_ENABLED=true
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama2"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"
OLLAMA_TIMEOUT=120

# ============================================================================
# VECTOR DATABASE CONFIGURATION
# ============================================================================
VECTOR_DB_TYPE="chromadb"
CHROMA_PERSIST_DIRECTORY="./data/chroma"
CHROMA_COLLECTION_NAME="knowledge_base_dev"
PINECONE_API_KEY=""
PINECONE_ENVIRONMENT=""
PINECONE_INDEX_NAME="genai-kb-dev"
EMBEDDING_DIMENSIONS=1536

# ============================================================================
# EXTERNAL API INTEGRATIONS - Confluence (Development)
# ============================================================================
CONFLUENCE_URL=""
CONFLUENCE_USERNAME=""
CONFLUENCE_API_TOKEN=""
CONFLUENCE_SPACE_KEYS=""
CONFLUENCE_PAGE_LIMIT=50
CONFLUENCE_INGEST_ATTACHMENTS=false

# ============================================================================
# EXTERNAL API INTEGRATIONS - Jira (Development)
# ============================================================================
JIRA_URL=""
JIRA_USERNAME=""
JIRA_API_TOKEN=""
JIRA_PROJECT_KEYS=""
JIRA_ISSUE_LIMIT=50
JIRA_INGEST_CLOSED_ISSUES=false

# ============================================================================
# DATA INGESTION SETTINGS
# ============================================================================
INGESTION_SCHEDULE_CRON="0 */12 * * *"
INGESTION_BATCH_SIZE=50
INGESTION_MAX_RETRIES=2
INGESTION_RETRY_DELAY=30
INGESTION_AUTO_START=false

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=200
RATE_LIMIT_ADMIN_PER_MINUTE=300
RATE_LIMIT_ANONYMOUS_PER_MINUTE=60
RATE_LIMIT_ENABLED=false


# ============================================================================
# CORS SETTINGS
# ============================================================================
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS="GET,POST,PUT,DELETE,PATCH,OPTIONS"
CORS_ALLOW_HEADERS="*"

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
LOG_FORMAT="text"
LOG_FILE_PATH="./logs/app.log"
LOG_MAX_SIZE_MB=50
LOG_BACKUP_COUNT=3
LOG_REQUESTS=true
LOG_SQL_QUERIES=true

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
PROMETHEUS_METRICS_PATH="/metrics"
HEALTHCHECK_ENABLED=true
HEALTHCHECK_PATH="/health"
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
SENTRY_SAMPLE_RATE=1.0

# ============================================================================
# CELERY (Background Tasks)
# ============================================================================
CELERY_BROKER_URL="redis://localhost:6379/3"
CELERY_RESULT_BACKEND="redis://localhost:6379/4"
CELERY_TASK_TIME_LIMIT=1800
CELERY_TASK_SOFT_TIME_LIMIT=1500
CELERY_MAX_TASKS_PER_CHILD=100
CELERY_WORKER_CONCURRENCY=2

# ============================================================================
# PERFORMANCE TUNING
# ============================================================================
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_SEARCH_RESULTS=5
SIMILARITY_THRESHOLD=0.70
MAX_CONTEXT_LENGTH=3000
CACHE_TTL=1800

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_CLARIFICATION_QUESTIONS=true
ENABLE_SOURCE_CITATIONS=true
ENABLE_METRICS_TRACKING=true
ENABLE_CONVERSATION_HISTORY=true
ENABLE_FEEDBACK_COLLECTION=true
ENABLE_MULTILINGUAL=false
