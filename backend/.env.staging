# ============================================================================
# STAGING ENVIRONMENT CONFIGURATION
# ============================================================================
# This file contains staging environment settings.
# Use this for pre-production testing and QA.
# SECURITY WARNING: Ensure all credentials are secured and rotated regularly!
# ============================================================================

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
APP_NAME="GenAI Knowledge Retrieval System"
APP_VERSION="1.0.0"
ENVIRONMENT="staging"
DEBUG=false
LOG_LEVEL="INFO"

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
HOST="0.0.0.0"
PORT=8000
WORKERS=4
REQUEST_TIMEOUT=300

# ============================================================================
# DATABASE CONFIGURATION - PostgreSQL
# ============================================================================
# SECURITY WARNING: Use strong passwords and restrict network access!
DATABASE_URL="postgresql+asyncpg://genai_user:CHANGE_ME_STAGING_DB_PASSWORD@postgres-staging:5432/genai_kb_staging"
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
REDIS_URL="redis://redis-staging:6379/0"
REDIS_SESSION_DB=1
REDIS_CACHE_DB=2
REDIS_POOL_SIZE=50
REDIS_TIMEOUT=5

# ============================================================================
# ELASTICSEARCH CONFIGURATION (Optional)
# ============================================================================
ELASTICSEARCH_URL="http://elasticsearch-staging:9200"
ELASTICSEARCH_USERNAME="elastic"
ELASTICSEARCH_PASSWORD="CHANGE_ME_ELASTICSEARCH_PASSWORD"
ELASTICSEARCH_INDEX_PREFIX="genai_kb_staging"
ELASTICSEARCH_SSL_VERIFY=true

# ============================================================================
# SECURITY & AUTHENTICATION
# ============================================================================
# SECURITY WARNING: Generate strong random secret key!
SECRET_KEY="CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# ============================================================================
# ADMIN CREDENTIALS (Initial Setup)
# ============================================================================
# SECURITY WARNING: Change immediately after deployment!
ADMIN_EMAIL="admin@staging.example.com"
ADMIN_PASSWORD="CHANGE_ME_ADMIN_PASSWORD"

# ============================================================================
# OAUTH2 CONFIGURATION
# ============================================================================
OAUTH2_PROVIDER="google"
OAUTH2_CLIENT_ID="your-oauth2-client-id-staging"
OAUTH2_CLIENT_SECRET="CHANGE_ME_OAUTH2_CLIENT_SECRET"
OAUTH2_AUTHORIZATION_ENDPOINT="https://accounts.google.com/o/oauth2/v2/auth"
OAUTH2_TOKEN_ENDPOINT="https://oauth2.googleapis.com/token"
OAUTH2_USERINFO_ENDPOINT="https://www.googleapis.com/oauth2/v2/userinfo"
OAUTH2_REDIRECT_URI="https://staging.example.com/api/v1/auth/oauth2/callback"
OAUTH2_SCOPES="openid profile email"

# ============================================================================
# LLM CONFIGURATION - OpenAI
# ============================================================================
# SECURITY WARNING: Protect API keys and monitor usage!
OPENAI_API_KEY="sk-CHANGE_ME_OPENAI_API_KEY"
OPENAI_MODEL="gpt-4-turbo-preview"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000
OPENAI_API_BASE=""
OPENAI_ORGANIZATION=""

# ============================================================================
# LLM CONFIGURATION - Ollama (Alternative)
# ============================================================================
OLLAMA_ENABLED=false
OLLAMA_BASE_URL="http://ollama-staging:11434"
OLLAMA_MODEL="llama2"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"
OLLAMA_TIMEOUT=120

# ============================================================================
# VECTOR DATABASE CONFIGURATION
# ============================================================================
VECTOR_DB_TYPE="chromadb"
CHROMA_PERSIST_DIRECTORY="/data/chroma"
CHROMA_COLLECTION_NAME="knowledge_base_staging"
PINECONE_API_KEY="CHANGE_ME_PINECONE_API_KEY"
PINECONE_ENVIRONMENT="us-west1-gcp"
PINECONE_INDEX_NAME="genai-kb-staging"
EMBEDDING_DIMENSIONS=1536

# ============================================================================
# EXTERNAL API INTEGRATIONS - Confluence
# ============================================================================
CONFLUENCE_URL="https://your-domain-staging.atlassian.net/wiki"
CONFLUENCE_USERNAME="confluence-api-user@example.com"
CONFLUENCE_API_TOKEN="CHANGE_ME_CONFLUENCE_API_TOKEN"
CONFLUENCE_SPACE_KEYS="KB,DOCS,ONBOARD"
CONFLUENCE_PAGE_LIMIT=100
CONFLUENCE_INGEST_ATTACHMENTS=true

# ============================================================================
# EXTERNAL API INTEGRATIONS - Jira
# ============================================================================
JIRA_URL="https://your-domain-staging.atlassian.net"
JIRA_USERNAME="jira-api-user@example.com"
JIRA_API_TOKEN="CHANGE_ME_JIRA_API_TOKEN"
JIRA_PROJECT_KEYS="PROJ,SUPPORT"
JIRA_ISSUE_LIMIT=100
JIRA_INGEST_CLOSED_ISSUES=true

# ============================================================================
# DATA INGESTION SETTINGS
# ============================================================================
INGESTION_SCHEDULE_CRON="0 */6 * * *"
INGESTION_BATCH_SIZE=100
INGESTION_MAX_RETRIES=3
INGESTION_RETRY_DELAY=60
INGESTION_AUTO_START=true


# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=100
RATE_LIMIT_ADMIN_PER_MINUTE=120
RATE_LIMIT_ANONYMOUS_PER_MINUTE=20
RATE_LIMIT_ENABLED=true

# ============================================================================
# CORS SETTINGS
# ============================================================================
CORS_ORIGINS="https://staging.example.com,https://staging-app.example.com"
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS="GET,POST,PUT,DELETE,PATCH,OPTIONS"
CORS_ALLOW_HEADERS="*"

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
LOG_FORMAT="json"
LOG_FILE_PATH="/var/log/genai-kb/app.log"
LOG_MAX_SIZE_MB=100
LOG_BACKUP_COUNT=10
LOG_REQUESTS=true
LOG_SQL_QUERIES=false

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
PROMETHEUS_METRICS_PATH="/metrics"
HEALTHCHECK_ENABLED=true
HEALTHCHECK_PATH="/health"
SENTRY_DSN="https://your-sentry-dsn@sentry.io/staging"
SENTRY_ENVIRONMENT="staging"
SENTRY_SAMPLE_RATE=1.0

# ============================================================================
# CELERY (Background Tasks)
# ============================================================================
CELERY_BROKER_URL="redis://redis-staging:6379/3"
CELERY_RESULT_BACKEND="redis://redis-staging:6379/4"
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3000
CELERY_MAX_TASKS_PER_CHILD=1000
CELERY_WORKER_CONCURRENCY=4

# ============================================================================
# PERFORMANCE TUNING
# ============================================================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_SEARCH_RESULTS=10
SIMILARITY_THRESHOLD=0.75
MAX_CONTEXT_LENGTH=4000
CACHE_TTL=3600

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_CLARIFICATION_QUESTIONS=true
ENABLE_SOURCE_CITATIONS=true
ENABLE_METRICS_TRACKING=true
ENABLE_CONVERSATION_HISTORY=true
ENABLE_FEEDBACK_COLLECTION=true
ENABLE_MULTILINGUAL=false
